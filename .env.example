# Secret values (Vercel Project Settings -> Environment Variables)
LOAF_API_KEY=replace-with-a-newly-rotated-key
CRON_SECRET=replace-with-at-least-32-random-characters

# 24/7 minute scheduler (cron-job.org). Create the job through /api/scheduler.
BOT_PUBLIC_URL=https://your-project.vercel.app
CRONJOB_API_KEY=
CRONJOB_JOB_ID=
# Set this to the final competition round number for automatic shutdown.
STOP_AFTER_ROUND_NUMBER=

# Durable distributed lock, telemetry and adaptive calibration (Upstash Redis REST).
# Configure both credentials, then set REQUIRE_DURABLE_LOCK=true before live trading.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_DURABLE_LOCK=false
STATE_NAMESPACE=loaf:league:trader
TELEMETRY_MAX_RUNS=2000

# Loaf API host. It must include /api.
LOAF_API_BASE_URL=https://api.loafmarkets.com/api

# Safety switches. Keep false through the observation/validation period.
TRADING_ENABLED=false
ALLOW_OUTSIDE_COMPETITION=false
# Normally a queued account is stopped locally. Use true only when the Loaf UI
# shows this exact API account is active and you need the exchange order endpoint
# to be the final eligibility authority.
QUEUE_POSITION_ADVISORY=false
# When an announced round is DRAFT, cancel quotes and wait for its capital reset.
HOLD_DURING_DRAFT_ROUND=true
KILL_SWITCH=false

# Required for leaderboard-adaptive risk. Set at least one once admitted.
LOAF_HANDLE=
LOAF_WALLET_ADDRESS=

# Optional comma-separated allowlist. Empty means all eligible LIVE markets.
LOAF_TARGET_TOKENS=

# Portfolio/risk limits (percent values are plain percentages).
STARTING_BALANCE_USDL=100000
MAX_DRAWDOWN_PCT=6
MAX_GROSS_EXPOSURE_PCT=60
MAX_MARKET_EXPOSURE_PCT=12
CASH_RESERVE_PCT=25
ORDER_NOTIONAL_PCT=2
COMPOUNDING_ENABLED=true
COMPOUNDING_PROFIT_REINVEST_PCT=100
COMPOUNDING_MAX_EQUITY_MULTIPLIER=1.5
QUALITY_SIZE_BOOST_MAX=1.35
POINTS_MODE_ENABLED=true
POINTS_ORDER_NOTIONAL_PCT=0.6
POINTS_MAX_MARKET_EXPOSURE_PCT=3
POINTS_DRAWDOWN_STOP_PCT=2
POINTS_MAX_ROUND_TRIP_COST_BPS=90

# Round 1: Volumemaxxing. Applies only while round 1 is ACTIVE.
# The bot still uses passive, non-crossing quotes and stops new points inventory on drawdown.
VOLUME_MAX_MODE=true
VOLUME_MAX_ROUND_NUMBER=1
# Baseline floor, not a cap. Above this target, rank-chasing follows projected P3 volume.
VOLUME_MAX_TARGET_VOLUME=30000000
VOLUME_RANK_CHASING_ENABLED=true
VOLUME_RANK_CHASING_MARGIN_PCT=12
VOLUME_RANK_CHASING_MIN_ELAPSED_PCT=2
# Fail-safe ceiling for malformed leaderboard data. Raise only after checking live P3 pace.
VOLUME_RANK_CHASING_MAX_TARGET_VOLUME=5000000000
VOLUME_MAX_CATCHUP_SCALE=1.25
VOLUME_MAX_MARKETS_PER_TICK=12
VOLUME_MAX_ORDERS_PER_TICK=10
VOLUME_MAX_POINTS_ORDER_NOTIONAL_PCT=0.75
VOLUME_MAX_POINTS_MAX_MARKET_EXPOSURE_PCT=4
VOLUME_MAX_BOOK_PARTICIPATION_PCT=20
VOLUME_MAX_QUOTE_TTL_SECONDS=90
STOP_LOSS_PCT=4
MIN_STOP_LOSS_PCT=1.5
MIN_TAKE_PROFIT_PCT=1.5
MAX_TAKE_PROFIT_PCT=4

# Execution controls.
MAX_MARKETS_PER_TICK=10
MAX_ORDERS_PER_TICK=6
QUOTE_TTL_SECONDS=240
REPRICE_THRESHOLD_BPS=20
MIN_NET_EDGE_BPS=30
MAX_SPREAD_BPS=120
LIQUIDITY_DEPTH_BPS=25
MAX_BOOK_PARTICIPATION_PCT=15
MIN_ORDER_NOTIONAL=10
TICK_SIZE=0.01

# Persistent WebSocket worker controls (VPS / container deployments).
WORKER_ENABLED=true
WORKER_MIN_TICK_MS=5000
WORKER_HEARTBEAT_MS=10000
WORKER_CATALOG_REFRESH_MS=60000
WORKER_CANDLE_REFRESH_MS=300000
WORKER_MAX_SUBSCRIPTIONS=24
# Avoid repeatedly submitting rejected orders while Loaf has not yet enabled this account.
WORKER_ELIGIBILITY_RETRY_MS=300000
